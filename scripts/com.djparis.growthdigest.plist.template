<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for the WEEKLY growth-intelligence digest.

  Companion to com.djparis.newsbrief.plist (daily). This one runs weekly,
  Monday at 6:00am, so the digest is waiting before the week's content
  decisions get made.

  One-time prerequisite (install deps for the python3 launchd will use):
    /usr/bin/python3 -m pip install --user feedparser anthropic youtube-transcript-api

  Setup:
  1. Copy this file to ~/Library/LaunchAgents/com.djparis.growthdigest.plist
  2. Replace REPLACE_WITH_YOUR_KEY with your real ANTHROPIC_API_KEY, and
     REPLACE_WITH_GMAIL_APP_PASSWORD with a Gmail App Password (see the email
     block below) to have the digest emailed to all your devices.
  3. Load it:   launchctl load ~/Library/LaunchAgents/com.djparis.growthdigest.plist
  4. Verify:    launchctl list | grep djparis
  5. Test now:  launchctl start com.djparis.growthdigest
  6. Wake the Mac just before the run so it fires on time even from sleep:
       sudo pmset repeat wake M 05:55:00
     (pmset day letters: M=Mon T=Tue W=Wed R=Thu F=Fri S=Sat U=Sun.
      Check with: pmset -g sched   Clear with: sudo pmset repeat cancel)

  The digest writes to
  ~/video-strategy-to-grow-dj-brand/data/growth-digests/YYYY-Www.md

  To disable temporarily:  launchctl unload ~/Library/LaunchAgents/com.djparis.growthdigest.plist
  To re-enable:            launchctl load ~/Library/LaunchAgents/com.djparis.growthdigest.plist
  To change the day/time:  edit Weekday/Hour/Minute below + the pmset wake, then unload + reload
  To check logs:           cat /tmp/growthdigest.log (stdout)
                           cat /tmp/growthdigest-err.log (errors)

  Why local, and the two sleep facts that matter:
  - Local on purpose: YouTube caption fetching and Reddit pulls are far more
    reliable from a residential IP than a cloud datacenter IP, the same reason
    the voice-tuning workflow pulls locally.
  - Sleep is fine. Without the pmset wake above, a job missed during sleep runs
    once at the next FULL wake (not during a Power Nap dark wake, which is what
    delivers your email/SMS dings -- that is push, not job execution). The pmset
    wake forces a full wake at 5:55 so the 6:00 job runs on schedule. The
    --lookback 8 below means even a slipped run never clips the week.
  - A LaunchAgent only runs while you are LOGGED IN. On an always-on mini,
    enable auto-login (System Settings > Users & Groups) so a reboot does not
    park it at the lock screen with the job waiting. Note: FileVault forces a
    login at boot and blocks auto-login, so after a reboot you would log in once.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.djparis.growthdigest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/djparis/video-strategy-to-grow-dj-brand/scripts/growth_digest.py</string>
    <string>--lookback</string>
    <string>8</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/djparis/video-strategy-to-grow-dj-brand</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ANTHROPIC_API_KEY</key>
    <string>REPLACE_WITH_YOUR_KEY</string>

    <!-- Email delivery. Set all three to email the digest to every device on
         the account. DIGEST_SMTP_APP_PASSWORD is a Gmail App Password (16
         chars), NOT your login password. Generate at myaccount.google.com ->
         Security -> 2-Step Verification -> App passwords. Leave as-is to skip
         email and just write the file. -->
    <key>DIGEST_EMAIL_TO</key>
    <string>delfinparis@gmail.com</string>
    <key>DIGEST_SMTP_USER</key>
    <string>delfinparis@gmail.com</string>
    <key>DIGEST_SMTP_APP_PASSWORD</key>
    <string>REPLACE_WITH_GMAIL_APP_PASSWORD</string>

    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/growthdigest.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/growthdigest-err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
