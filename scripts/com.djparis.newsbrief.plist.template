<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for daily news brief generation.

  Setup:
  1. Copy this file to ~/Library/LaunchAgents/com.djparis.newsbrief.plist
  2. Fill in the placeholder values in EnvironmentVariables below:
       - ANTHROPIC_API_KEY      (required)
       - DIGEST_EMAIL_TO / DIGEST_SMTP_USER / DIGEST_SMTP_APP_PASSWORD
         (optional; turns on the morning email. The script also accepts the
         BRIEF_* names. The growth digest uses the same DIGEST_* set, so one
         set of credentials drives both engines.)
       - NTFY_TOPIC             (optional; turns on the real-time push)
  3. Load it:   launchctl load ~/Library/LaunchAgents/com.djparis.newsbrief.plist
  4. Verify:    launchctl list | grep djparis
  5. Test now:  launchctl start com.djparis.newsbrief

  Secrets live ONLY in the installed copy under ~/Library/LaunchAgents, never in
  this repo template. Keep the placeholders here.

  The brief generates daily at 6:30am: tiered feeds -> dedup -> drop already-
  covered -> Haiku rank -> fetch article bodies -> Sonnet takes -> email + push.
  Output writes to ~/video-strategy-to-grow-dj-brand/data/news-briefs/YYYY-MM-DD.md

  To disable temporarily:  launchctl unload ~/Library/LaunchAgents/com.djparis.newsbrief.plist
  To re-enable:            launchctl load ~/Library/LaunchAgents/com.djparis.newsbrief.plist
  To change time:          edit Hour/Minute below, then unload + reload
  To check logs:           cat /tmp/newsbrief.log (stdout)
                           cat /tmp/newsbrief-err.log (errors)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.djparis.newsbrief</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/djparis/video-strategy-to-grow-dj-brand/scripts/news_brief.py</string>
    <!-- --draft 1: also draft + polish the top take into a full NF script and
         email it. Drop these two strings to get the brief + stat tip only. -->
    <string>--draft</string>
    <string>1</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/djparis/video-strategy-to-grow-dj-brand</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ANTHROPIC_API_KEY</key>
    <string>REPLACE_WITH_YOUR_KEY</string>
    <!-- Optional: morning email. Delete these three to write the file only. -->
    <key>DIGEST_EMAIL_TO</key>
    <string>REPLACE_WITH_YOUR_EMAIL</string>
    <key>DIGEST_SMTP_USER</key>
    <string>REPLACE_WITH_YOUR_EMAIL</string>
    <key>DIGEST_SMTP_APP_PASSWORD</key>
    <string>REPLACE_WITH_GMAIL_APP_PASSWORD</string>
    <!-- Optional: real-time push. Delete to rely on email alone. -->
    <key>NTFY_TOPIC</key>
    <string>REPLACE_WITH_PRIVATE_NTFY_TOPIC</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/newsbrief.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/newsbrief-err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
